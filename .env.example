# Copie para .env e ajuste. O .env não é versionado.
# Sem preencher nada, o sistema roda com dados de demonstração e sem integrações externas.

# Banco de dados (o docker compose cria o Postgres com estes valores)
DB_USERNAME=docflow
DB_PASSWORD=docflow

# Acesso ao sistema (login único). No docker compose, o padrão é demo / demo.
# Fora do Docker, APP_PASSWORD é obrigatório: sem ele, a aplicação não sobe.
# Aceita texto puro ou um hash pronto ({bcrypt}$2a$...).
APP_USERNAME=demo
APP_PASSWORD=demo
# Tempo sem uso até a sessão expirar
SESSION_TIMEOUT=8h
# true quando o sistema estiver atrás de HTTPS
SESSION_COOKIE_SECURE=false

# Identidade do negócio
APP_BUSINESS_NAME=Ateliê Exemplo
APP_OWNER_NAME=
# Caminho de uma imagem PNG de assinatura para o PDF do contrato (opcional)
APP_SIGNATURE_IMAGE=

# Assinatura eletrônica (Autentique). Crie um token em https://painel.autentique.com.br
AUTENTIQUE_API_TOKEN=
AUTENTIQUE_SANDBOX_ENABLED=true
AUTENTIQUE_ACCOUNT_EMAIL=

# E-mail (SMTP). Para Gmail, use uma senha de app.
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_NOTIFICATIONS_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Assistente de IA (Ollama). No Docker, use http://host.docker.internal:11434 para o Ollama da sua máquina.
AI_ENABLED=false
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b

# Tamanho máximo de upload (anexos e PDFs)
UPLOAD_MAX_FILE_SIZE=20MB
